# Copy to backend/.env  (never commit real secrets)
NODE_ENV=development
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://mailpilot:mailpilot@localhost:5432/mailpilot
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Generate: openssl rand -hex 32   (encrypts Slack tokens at rest)
TOKEN_ENCRYPTION_KEY=

# Google OAuth. Redirect URI must be exactly: <BACKEND_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Slack OAuth (scope: chat:write). Redirect URL must be exactly: <BACKEND_URL>/api/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=

# SMTP. Leave SMTP_USER/SMTP_PASS empty to auto-create a free Ethereal test account at worker start
# (needs internet), or paste credentials from https://ethereal.email/create
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

WORKER_CONCURRENCY=3
EMAIL_ATTEMPTS=3
EMAIL_BACKOFF_MS=5000
# Comma-separated emails allowed to open /admin/queues when NODE_ENV=production
ADMIN_EMAILS=
