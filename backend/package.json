{
  "name": "mailpilot-backend", "version": "1.0.0", "type": "module", "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "start": "node dist/server.js",
    "worker:start": "node dist/worker.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@bull-board/api": "^6.0.0", "@bull-board/express": "^6.0.0",
    "@elastic/elasticsearch": "^8.14.0",
    "@prisma/adapter-pg": "^7.0.0", "@prisma/client": "^7.0.0",
    "bullmq": "^5.12.0", "dotenv": "^16.4.5", "express": "^4.19.2", "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1", "nodemailer": "^6.9.14", "pg": "^8.12.0", "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21", "@types/multer": "^1.4.11", "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15", "@types/pg": "^8.11.6", "@types/smtp-server": "^3.5.10",
    "@types/supertest": "^6.0.2", "prisma": "^7.0.0", "smtp-server": "^3.13.4",
    "supertest": "^7.0.0", "tsx": "^4.16.0", "typescript": "^5.5.0", "vitest": "^2.0.0"
  }
}
